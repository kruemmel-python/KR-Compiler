#include <iostream>
#include <vector>
#include "kr_adaptive_compute.h"

// Dieser Loop ist absichtlich so geschrieben, dass Adaptive Compute seine
// Unabhängigkeit beweisen und ihn als GPU_ELIGIBLE einstufen kann.
void vector_add(float* out, const float* a, const float* b, int n) {
    for (int i = 0; i < n; i++) {
        out[i] = a[i] + b[i];
    }
}

int main() {
    const int count = 8192;
    std::vector<float> a(count, 2.0f);
    std::vector<float> b(count, 3.0f);
    std::vector<float> out(count, 0.0f);

    // Die generierte portable API entscheidet deterministisch zwischen CPU und GPU.
    // Bei einem GPU-Fehler darf AUTO auf die unveränderte CPU-Referenz zurückfallen.
    kr_compute_set_telemetry_path("adaptive_compute_telemetry.jsonl");
    if (!kr_compute_add_f32(a.data(), b.data(), out.data(), count)) {
        std::cerr << "Adaptive Compute konnte die Operation nicht ausführen." << std::endl;
        return 1;
    }

    std::cout << "Adaptive Compute Ergebnis:";
    for (int i = 0; i < 8; i++) {
        std::cout << ' ' << out[i];
    }
    std::cout << std::endl;
    return 0;
}
