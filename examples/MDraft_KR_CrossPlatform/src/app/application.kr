#include "include/mdraft/mdraft.hpp"
#include <algorithm>

namespace mdraft {

namespace {
const char* kInitialDocument =
    "# MDraft KR\n"
    "\n"
    "Ein modularer nativer Markdown-Editor.\n"
    "\n"
    "## Plattformen\n"
    "- [x] Android ARM64\n"
    "- [x] Windows x64\n"
    "- [x] Linux x64\n"
    "\n"
    "> Tab oder VORSCHAU wechselt die Darstellung.\n"
    "\n"
    "| Taste | Funktion |\n"
    "| Ctrl+S | Speichern |\n"
    "| Ctrl+N | Neues Dokument |\n"
    "\n"
    "```\n"
    "Normale .kr Module, SDL3 und ein eingebetteter Bitmap-Font.\n"
    "```\n";

bool contains(const SDL_FRect& rectangle, float x, float y) {
    return x >= rectangle.x && y >= rectangle.y
        && x < rectangle.x + rectangle.w && y < rectangle.y + rectangle.h;
}

void new_document(GapBuffer& buffer, EditorState& state) {
    buffer.set_text(kInitialDocument);
    state.path = "mdraft_document.md";
    state.status = "Neues Dokument";
    state.dirty = false;
    state.preview = false;
    state.scroll_row = 0;
}

void toggle_preview(EditorState& state) {
    state.preview = !state.preview;
    state.status = state.preview ? "Vorschau" : "Editor";
}

void keep_cursor_visible(const GapBuffer& buffer, EditorState& state, int visible_rows) {
    const int row = static_cast<int>(buffer.line_column().first);
    if (row < state.scroll_row) state.scroll_row = row;
    if (row >= state.scroll_row + visible_rows) state.scroll_row = row - visible_rows + 1;
    state.scroll_row = std::max(0, state.scroll_row);
}

void activate_pointer(float x, float y, const UiLayout& layout,
                      GapBuffer& buffer, EditorState& state, int visible_rows) {
    if (contains(layout.new_button, x, y)) {
        new_document(buffer, state);
    } else if (contains(layout.save_button, x, y)) {
        save_document(buffer, state);
    } else if (contains(layout.mode_button, x, y)) {
        toggle_preview(state);
    } else if (!state.preview && contains(layout.content, x, y)) {
        const int row = std::max(0, static_cast<int>((y - layout.content.y - 8) / 20.0f));
        const int column = std::max(0, static_cast<int>((x - layout.content.x - 8) / 12.0f) - 5);
        buffer.move_to_line_column(static_cast<std::size_t>(state.scroll_row + row),
                                   static_cast<std::size_t>(column));
        keep_cursor_visible(buffer, state, visible_rows);
        state.status = "Editor aktiv";
    }
}
}

int run_application(int argc, char** argv) {
    if (!SDL_Init(SDL_INIT_VIDEO | SDL_INIT_EVENTS)) return 1;

    // Normale KR-Schleife aus dem Theme-Modul. Die bestehende Compilerpipeline
    // erkennt sie automatisch; der Anwendungscode kennt keine Compute-API.
    const float theme_base[4]{15.0f, 19.0f, 29.0f, 255.0f};
    const float theme_accent[4]{76.0f, 173.0f, 206.0f, 0.0f};
    float theme_preview[4]{};
    compose_theme_channels(theme_preview, theme_base, theme_accent, 4);

    SDL_Window* window = SDL_CreateWindow(
        "MDraft KR - Modular Cross Platform",
        1100, 740,
        SDL_WINDOW_RESIZABLE | SDL_WINDOW_HIGH_PIXEL_DENSITY);
    if (!window) {
        SDL_Quit();
        return 2;
    }
    SDL_Renderer* renderer = SDL_CreateRenderer(window, nullptr);
    if (!renderer) {
        SDL_DestroyWindow(window);
        SDL_Quit();
        return 3;
    }

    GapBuffer buffer(kInitialDocument);
    EditorState state;
    if (argc > 1 && argv && argv[1]) load_document(buffer, state, argv[1]);
    else state.status = theme_preview[0] > 0.0f
        ? "Bereit - Text eingeben oder VORSCHAU waehlen"
        : "Theme konnte nicht initialisiert werden";

    SDL_StartTextInput(window);
    UiLayout layout{};
    while (state.running) {
        int render_width = 0;
        int render_height = 0;
        SDL_GetRenderOutputSize(renderer, &render_width, &render_height);
        const int visible_rows = std::max(1, (render_height - 120) / 20);

        SDL_Event event;
        while (SDL_PollEvent(&event)) {
            if (event.type == SDL_EVENT_QUIT) {
                state.running = false;
            } else if (event.type == SDL_EVENT_TEXT_INPUT && !state.preview) {
                buffer.insert_text(event.text.text ? event.text.text : "");
                state.dirty = true;
                state.status = "Bearbeitet";
                keep_cursor_visible(buffer, state, visible_rows);
            } else if (event.type == SDL_EVENT_MOUSE_WHEEL) {
                state.scroll_row = std::max(0, state.scroll_row - static_cast<int>(event.wheel.y * 3.0f));
            } else if (event.type == SDL_EVENT_MOUSE_BUTTON_DOWN) {
                activate_pointer(event.button.x, event.button.y, layout, buffer, state, visible_rows);
            } else if (event.type == SDL_EVENT_FINGER_DOWN) {
                activate_pointer(event.tfinger.x * render_width, event.tfinger.y * render_height,
                                 layout, buffer, state, visible_rows);
            } else if (event.type == SDL_EVENT_KEY_DOWN) {
                const bool control = (event.key.mod & SDL_KMOD_CTRL) != 0;
                const SDL_Keycode key = event.key.key;
                if (control && key == SDLK_S) save_document(buffer, state);
                else if (control && key == SDLK_N) new_document(buffer, state);
                else if (control && key == SDLK_O) state.status = "Datei beim Start als Argument uebergeben";
                else if (key == SDLK_TAB) toggle_preview(state);
                else if (key == SDLK_ESCAPE) state.running = false;
                else if (!state.preview && key == SDLK_BACKSPACE) {
                    if (buffer.erase_before()) { state.dirty = true; state.status = "Bearbeitet"; }
                } else if (!state.preview && key == SDLK_DELETE) {
                    if (buffer.erase_at()) { state.dirty = true; state.status = "Bearbeitet"; }
                } else if (!state.preview && (key == SDLK_RETURN || key == SDLK_KP_ENTER)) {
                    buffer.insert_text("\n"); state.dirty = true; state.status = "Bearbeitet";
                } else if (!state.preview && key == SDLK_LEFT) buffer.move_left();
                else if (!state.preview && key == SDLK_RIGHT) buffer.move_right();
                else if (!state.preview && key == SDLK_UP) buffer.move_vertical(-1);
                else if (!state.preview && key == SDLK_DOWN) buffer.move_vertical(1);
                else if (!state.preview && key == SDLK_HOME) buffer.move_home();
                else if (!state.preview && key == SDLK_END) buffer.move_end();
                else if (key == SDLK_PAGEUP) state.scroll_row = std::max(0, state.scroll_row - visible_rows);
                else if (key == SDLK_PAGEDOWN) state.scroll_row += visible_rows;
                keep_cursor_visible(buffer, state, visible_rows);
            }
        }

        layout = render_editor(renderer, window, buffer, state, SDL_GetTicks());
        SDL_Delay(16);
    }

    SDL_StopTextInput(window);
    SDL_DestroyRenderer(renderer);
    SDL_DestroyWindow(window);
    SDL_Quit();
    return 0;
}

} // namespace mdraft
