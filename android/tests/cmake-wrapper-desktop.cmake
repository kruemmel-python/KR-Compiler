if(NOT DEFINED KR_EXECUTABLE_OUTPUT)
  message(FATAL_ERROR "KR_EXECUTABLE_OUTPUT fehlt")
endif()

function(add_executable target)
  set(_kr_args ${ARGN})
  list(FIND _kr_args "IMPORTED" _kr_imported)
  list(FIND _kr_args "ALIAS" _kr_alias)
  if(NOT _kr_imported EQUAL -1 OR NOT _kr_alias EQUAL -1)
    _add_executable(${target} ${ARGN})
    return()
  endif()
  file(RELATIVE_PATH _kr_relative "${CMAKE_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}")
  if(_kr_relative MATCHES "^\\.\\.")
    _add_executable(${target} ${ARGN})
    return()
  endif()
  _add_executable(${target} ${ARGN})
  set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${KR_EXECUTABLE_OUTPUT}")
  set_property(GLOBAL APPEND PROPERTY KR_EXECUTABLE_TARGETS "${target}")
endfunction()
